{
  "name": "whatfraud",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "docs:check": "node tools/checks/check-docs.mjs",
    "content:build": "node tools/content/build-content.mjs",
    "content:check": "node tools/content/build-content.mjs --check",
    "dialogue:check": "node tools/dialogue/evaluate-dialogue.mjs",
    "dialogue:gemini:evaluate": "node tools/dialogue/evaluate-live-gemini.mjs",
    "release:check": "node tools/checks/check-release.mjs",
    "predev": "node tools/content/build-content.mjs",
    "dev": "vinext dev",
    "prebuild": "node tools/content/build-content.mjs && node tools/dialogue/evaluate-dialogue.mjs && node tools/checks/check-release.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "prelint": "node tools/content/build-content.mjs --check && node tools/dialogue/evaluate-dialogue.mjs",
    "lint": "eslint --config tools/config/eslint.config.mjs . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate --config drizzle/drizzle.config.ts",
    "security:check": "node tools/checks/check-security.mjs",
    "dependencies:check": "node tools/checks/check-dependencies.mjs",
    "test:story": "node tools/tests/test-story.mjs && node tools/tests/test-attachment-branches.mjs && node tools/tests/test-decision-messages.mjs && node tools/tests/test-message-transcript.mjs && node tools/tests/test-response-report.mjs && node tools/tests/test-evidence-notes.mjs",
    "test:ui": "node tools/tests/test-story-ui.mjs",
    "test:api": "node tools/tests/test-ai-chat.mjs && node tools/tests/test-budget.mjs",
    "test": "pnpm test:story && pnpm test:ui && pnpm test:api"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.1.6",
    "wrangler": "4.92.0",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10"
  },
  "type": "module"
}
