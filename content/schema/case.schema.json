{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whatfraud.invalid/schema/case.schema.json",
  "title": "WhatFraud scenario case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sender", "handle", "channel", "mode", "preview", "verdict", "category",
    "initialMessages", "role", "npcGoal", "allowedClaims", "checks", "clueLabels",
    "debrief", "safeAction"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sender": { "type": "string", "minLength": 1 },
    "handle": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["메신저", "문자", "앱 알림", "SNS"] },
    "mode": { "enum": ["chat", "notice", "link"] },
    "preview": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["normal", "caution", "scam"] },
    "category": { "type": "string", "minLength": 1 },
    "initialMessages": { "$ref": "#/$defs/nonEmptyStringArray" },
    "role": { "type": "string", "minLength": 1 },
    "npcGoal": { "type": "string", "minLength": 1 },
    "allowedClaims": { "$ref": "#/$defs/nonEmptyStringArray" },
    "fallbackReplies": { "$ref": "#/$defs/nonEmptyStringArray" },
    "dialogue": { "$ref": "#/$defs/dialogue" },
    "checks": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": false,
      "properties": {
        "home": { "type": "string", "minLength": 1 },
        "bank": { "type": "string", "minLength": 1 },
        "cafe": { "type": "string", "minLength": 1 },
        "police": { "type": "string", "minLength": 1 },
        "library": { "type": "string", "minLength": 1 }
      }
    },
    "clueLabels": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "debrief": { "type": "string", "minLength": 1 },
    "safeAction": { "type": "string", "minLength": 1 },
    "displayUrl": { "type": "string", "pattern": "^[a-z0-9.-]+\\.invalid(?:/[^\\s]*)?$" },
    "linkLabel": { "type": "string", "minLength": 1 },
    "landingTitle": { "type": "string", "minLength": 1 },
    "landingCopy": { "type": "string", "minLength": 1 },
    "landingCta": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "chat" } }, "required": ["mode"] },
      "then": { "required": ["fallbackReplies", "dialogue"] },
      "else": { "not": { "anyOf": [{ "required": ["fallbackReplies"] }, { "required": ["dialogue"] }] } }
    },
    {
      "if": { "properties": { "mode": { "const": "link" } }, "required": ["mode"] },
      "then": { "required": ["displayUrl", "linkLabel", "landingTitle", "landingCopy", "landingCta"] }
    }
  ],
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "progression", "boundaries", "quickQuestions", "fallbackByTopic"],
      "properties": {
        "voice": { "type": "string", "minLength": 1 },
        "progression": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "boundaries": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "quickQuestions": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
        "fallbackByTopic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "identity", "risk", "money", "default"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "identity": { "type": "string", "minLength": 1 },
            "risk": { "type": "string", "minLength": 1 },
            "money": { "type": "string", "minLength": 1 },
            "default": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
